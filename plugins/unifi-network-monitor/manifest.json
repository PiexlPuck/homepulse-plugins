{
    "id": "unifi-network-monitor",
    "name": "UniFi Network Monitor",
    "version": "1.0.1",
    "author": "HomePulse Community",
    "min_homepulse_version": "1.0.0",
    "entrypoint": "main.py",
    "ui_card": "assets/card.js",
    "permissions": [
        "network_outbound",
        "host_metrics"
    ],
    "settings_schema": {
        "unifi_ip": {
            "type": "string",
            "required": true,
            "default": "192.168.1.1",
            "label": "UniFi Console IP / Host"
        },
        "unifi_user": {
            "type": "string",
            "required": true,
            "default": "admin",
            "label": "UniFi Local Admin Username"
        },
        "unifi_password": {
            "type": "password",
            "required": true,
            "label": "UniFi Local Admin Password"
        },
        "unifi_site_id": {
            "type": "string",
            "required": false,
            "default": "default",
            "label": "UniFi Site ID"
        },
        "interval": {
            "type": "integer",
            "required": false,
            "default": 30,
            "label": "Sync Interval (s)"
        }
    },
    "entities": {
        "unifi-network-clients": {
            "name": "UniFi Network Clients",
            "type": "sensor",
            "ui_schema": {
                "widget": "table",
                "columns": [
                    "mac",
                    "ip",
                    "hostname",
                    "is_wired",
                    "signal"
                ]
            }
        },
        "unifi-network-devices": {
            "name": "UniFi Network Devices",
            "type": "sensor",
            "ui_schema": {
                "widget": "table",
                "columns": [
                    "name",
                    "model",
                    "state",
                    "uptime",
                    "cpu",
                    "mem"
                ]
            }
        }
    }
}