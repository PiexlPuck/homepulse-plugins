{
    "id": "nginx-proxy-manager",
    "name": "Nginx Proxy Manager",
    "version": "1.1.4",
    "author": "HomePulse Community",
    "min_homepulse_version": "1.0.0",
    "entrypoint": "main.py",
    "ui_card": "assets/card.js",
    "permissions": [
        "network_outbound",
        "host_metrics"
    ],
    "settings_schema": {
        "npm_ip": {
            "type": "string",
            "required": true,
            "default": "192.168.0.142",
            "label": "Nginx Proxy Manager IP / Host"
        },
        "identity": {
            "type": "string",
            "required": true,
            "default": "admin@example.com",
            "label": "NPM Admin Email"
        },
        "secret": {
            "type": "password",
            "required": true,
            "label": "NPM Admin Password"
        },
        "interval": {
            "type": "integer",
            "required": false,
            "default": 30,
            "label": "Sync Interval (s)"
        }
    },
    "entities": {
        "npm-proxy-summary": {
            "name": "NPM Proxy Summary",
            "type": "sensor",
            "ui_schema": {
                "widget": "table",
                "columns": [
                    "id",
                    "domain_names",
                    "forward_host",
                    "forward_port",
                    "enabled",
                    "ssl_forced"
                ]
            }
        }
    }
}