{
    "id": "synology-monitor",
    "name": "Synology Monitor",
    "version": "1.0.0",
    "author": "HomePulse Community",
    "min_homepulse_version": "1.0.0",
    "entrypoint": "main.py",
    "ui_card": "assets/card.js",
    "permissions": [
        "network_outbound",
        "host_metrics"
    ],
    "settings_schema": {
        "synology_url": {
            "type": "string",
            "required": true,
            "default": "https://192.168.0.100:5001/webapi/",
            "label": "Synology API base URL"
        },
        "synology_user": {
            "type": "string",
            "required": true,
            "default": "admin",
            "label": "Synology Admin Account Name"
        },
        "synology_password": {
            "type": "password",
            "required": true,
            "label": "Synology Admin Password"
        },
        "interval": {
            "type": "integer",
            "required": false,
            "default": 30,
            "label": "Sync Interval (s)"
        }
    },
    "entities": {
        "synology-storage-summary": {
            "name": "Synology Storage Summary",
            "type": "sensor",
            "ui_schema": {
                "widget": "table",
                "columns": [
                    "volume",
                    "status",
                    "used_percent",
                    "size_used",
                    "size_total"
                ]
            }
        }
    }
}