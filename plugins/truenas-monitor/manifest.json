{
    "id": "truenas-monitor",
    "name": "TrueNAS Monitor",
    "version": "1.1.5",
    "author": "HomePulse Community",
    "min_homepulse_version": "1.0.0",
    "entrypoint": "main.py",
    "ui_card": "assets/card.js",
    "permissions": [
        "network_outbound",
        "host_metrics"
    ],
    "settings_schema": {
        "truenas_ip": {
            "type": "string",
            "required": true,
            "default": "192.168.0.100",
            "label": "TrueNAS IP / Host"
        },
        "api_key": {
            "type": "password",
            "required": true,
            "label": "TrueNAS API Key"
        },
        "interval": {
            "type": "integer",
            "required": false,
            "default": 30,
            "label": "Sync Interval (s)"
        }
    },
    "entities": {
        "truenas-pools-summary": {
            "name": "TrueNAS Pools Summary",
            "type": "sensor",
            "ui_schema": {
                "widget": "table",
                "columns": [
                    "name",
                    "status",
                    "healthy"
                ]
            }
        },
        "truenas-vms-active": {
            "name": "TrueNAS VMs Summary",
            "type": "sensor",
            "ui_schema": {
                "widget": "table",
                "columns": [
                    "name",
                    "state",
                    "cores",
                    "memory"
                ]
            }
        },
        "truenas-alerts-count": {
            "name": "TrueNAS Active Alerts",
            "type": "sensor",
            "ui_schema": {
                "widget": "table",
                "columns": [
                    "id",
                    "level",
                    "message",
                    "datetime"
                ]
            }
        }
    }
}